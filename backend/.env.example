# Server Configuration
PORT=3000
NODE_ENV=development

# Neon DB Configuration (PostgreSQL)
# Get your connection string from: https://console.neon.tech
DATABASE_URL="postgresql://username:password@ep-xxx.us-east-2.aws.neon.tech/stayhub?sslmode=require"

# For local PostgreSQL testing:
# DATABASE_URL="postgresql://postgres:password@localhost:5432/stayhub"

# JWT Secret for authentication
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# CORS Origin (your Flutter app URL)
CORS_ORIGIN=*
